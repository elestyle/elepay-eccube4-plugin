<div class="hidden">
    <div id="elepay_info">
        {% for item in payment_methods %}
            {# 外部 JSON 由来の URL を CSS の url() に埋め込まず、src 属性として出力する #}
            {% if item.image %}
                <img class="elepay-payment-method-icon" src="{{ item.image }}" alt="{{ item.name }}" title="{{ item.name }}">
            {% endif %}
        {% endfor %}
    </div>
</div>

{% block javascript %}
<script>
$(function () {
    var $radio = $('input#shopping_order_Payment_{{ payment_id|e('js') }}');
    var $label = $radio.siblings('label');
    $label.after($('#elepay_info'));
});
</script>
{% endblock javascript %}

{% block stylesheet %}
<style>
#elepay_info {
    display: block;
    padding: 15px;
}

.elepay-payment-method-icon {
    display: inline-block;
    margin-right: 8px;
    margin-bottom: 8px;
    width: 24px;
    height: 20px;
    object-fit: contain;
    vertical-align: middle;
}
</style>
{% endblock %}
